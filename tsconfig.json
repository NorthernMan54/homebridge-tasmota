{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "esnext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": false,
    "declaration": true,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ]
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/__mocks__",
    "vitest.config.ts",
    "dist"
  ]
}